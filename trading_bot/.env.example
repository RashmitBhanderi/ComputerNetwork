# ─────────────────────────────────────────────────────────────────────────────
# AI Options Paper Trading Bot — environment configuration
# Copy this file to `.env` and fill in your keys:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Alpaca Markets — paper trading account (https://alpaca.markets)
# Dashboard -> Home -> "Generate New Key" (make sure "Paper" is selected)
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Tradier — options Greeks / chains (https://developer.tradier.com)
# Use a sandbox token to start; production token for live data.
TRADIER_API_KEY=your_tradier_token_here
TRADIER_BASE_URL=https://api.tradier.com

# NewsAPI — headlines (https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_key_here

# Benzinga — optional secondary news source (https://www.benzinga.com/apis)
# Leave blank to disable; the bot degrades gracefully without it.
BENZINGA_API_KEY=

# Anthropic — Claude API for sentiment scoring + trade analysis
# (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_key_here

# ─── Optional tuning overrides (sane defaults live in config.py) ────────────
# WATCHLIST=SPY,QQQ,AAPL,TSLA,NVDA,AMZN
# STARTING_CAPITAL=100000
# MIN_CONFIDENCE=65
# MAX_OPEN_POSITIONS=3
# MAX_RISK_PER_TRADE_PCT=5
# STOP_LOSS_PCT=40
# VIX_HALT_THRESHOLD=35
